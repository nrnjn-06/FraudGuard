{
  "manifest_version": 3,
  "name": "FraudGuard",
  "version": "1.0.0",
  "description": "Detects deceptive UI patterns and suspicious e-commerce behaviour.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
